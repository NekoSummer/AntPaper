<?xml version="1.0" encoding="UTF-8" ?>
<project name="AntPaper" default="dist" basedir="." >
    <description>用于构建老版本Paper插件的模板(用于1.8 ～ 1.16)</description>
    <property name="plugin.name" value="AntPaper" />
    <property name="plugin.version" value="1.0-SNAPSHOT" />

    <property name="lib.paper" location="lib/libpaper.jar" />

    <property name="src.dir" location="src" />
    <property name="dist.dir" location="dist" />
    <property name="bin.dir" location="bin" />

    <target name="init">
        <mkdir dir="${bin.dir}"/>
    </target>

    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${bin.dir}" includeantruntime="false"
            source="8" target="8" encoding="UTF-8">
            <compilerarg value="-Xlint:-options"/>
            <classpath>
                <pathelement location="${lib.paper}" />
            </classpath>
        </javac>
    </target>

    <target name="dist" depends="compile">
        <mkdir dir="${dist.dir}" />
        <jar jarfile="${dist.dir}/${plugin.name}-${plugin.version}.jar">
            <fileset dir="${bin.dir}" />
            <fileset file="plugin.yml" />
        </jar>
    </target>

    <target name="clean">
        <!-- Build cache -->
        <delete dir="${bin.dir}" />
        <delete dir="${dist.dir}" />

        <!-- Server dir -->
        <delete dir="logs" />
        <delete dir="plugins" />
        <delete dir="world" />
        <delete dir="world_nether" />
        <delete dir="world_the_end" />

        <!-- Files -->
        <delete file="banned-ips.json" />
        <delete file="banned-players.json" />
        <delete file="bukkit.yml" />
        <delete file="commands.yml" />
        <delete file="eula.txt" />
        <delete file="help.yml" />
        <delete file="ops.json" />
        <delete file="paper.yml" />
        <delete file="permissions.yml" />
        <delete file="server.properties" />
        <delete file="spigot.yml" />
        <delete file="usercache.json" />
        <delete file="whitelist.json" />
    </target>

    <target name="test" depends="dist">
        <mkdir dir="plugins" />
        <copy file="${dist.dir}/${plugin.name}-${plugin.version}.jar"
              todir="plugins" overwrite="true"/>
        <java jar="${lib.paper}" fork="true" failonerror="true">
            <arg value="nogui" />
        </java>
    </target>
</project>